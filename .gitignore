# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging and distribution artifacts
build/
dist/
*.egg-info/
.eggs/

# Test and coverage outputs
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type/lint/tool caches
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Local editor/OS files
.DS_Store
.vscode/
.idea/

# Optional local plugin data
data/

# Local runtime config that may include tokens
config.json

# Common secret/certificate files
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
